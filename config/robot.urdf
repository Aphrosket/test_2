<?xml version="1.0"?>
<robot name="omni_car">
  <link name="base_link">
    <visual><geometry><box size="0.45 0.35 0.18"/></geometry><material name="blue"><color rgba="0.1 0.4 0.9 1"/></material></visual>
  </link>
  <link name="laser">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry></visual>
  </link>
  <joint name="laser_fixed" type="fixed">
    <parent link="base_link"/><child link="laser"/><origin xyz="0 0 0.18" rpy="0 0 0"/>
  </joint>
</robot>
